#!/usr/bin/env bash
# webmtproxy — control panel for a WebMTProxy install.
#
# Reads its state straight out of the files the deploy scripts write, so there
# is no second copy of the truth to drift: hostname from the relay config,
# secret from the profiles file, ACME contact from the caddy drop-in.
set -euo pipefail

CONFIG=/etc/tproxy-server/config.json
PROFILES=/etc/tproxy-server/profiles.json
MTPROXY_ENV=/etc/mtproxy/mtproxy.env
CADDY_DROPIN=/etc/systemd/system/caddy.service.d/tproxy.conf
SITE_ROOT=/srv/tproxy-site
MTPROXY_UNIT=/etc/systemd/system/mtproxy.service
TAG_DROPIN=/etc/systemd/system/mtproxy.service.d/tag.conf
SELF=/opt/webmtproxy
UNITS=(caddy mtproxy tproxy-server tproxy-firewall)
W=52

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
	B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'
	RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; CYN=$'\e[36m'
else
	B=; D=; R=; RED=; GRN=; YLW=; CYN=
fi

die()  { printf '\n  %s✗%s %s\n\n' "$RED" "$R" "$*" >&2; exit 1; }
warn() { printf '  %s!%s %s\n' "$YLW" "$R" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$GRN" "$R" "$*"; }
head2() { printf '\n  %s%s%s\n' "$D" "$1" "$R"; }

# ── state ────────────────────────────────────────────────────────────────────

require_root()    { [[ ${EUID} -eq 0 ]] || die "run as root: sudo webmtproxy $*"; }
require_install() { [[ -f $CONFIG && -f $PROFILES ]] || die "no WebMTProxy install found — run install.sh first"; }

read_domain() { sed -n 's/.*"public_hostname": *"\([^"]*\)".*/\1/p' "$CONFIG"; }
read_secret() { sed -n 's/.*"secret": *"\([^"]*\)".*/\1/p' "$PROFILES"; }
read_email()  { sed -n 's/^Environment=ACME_EMAIL=//p' "$CADDY_DROPIN" 2>/dev/null || true; }
read_tag()    { sed -n 's/^Environment=MTPROXY_TAG=//p' "$TAG_DROPIN" 2>/dev/null | grep . || return 1; }
tg_link()     { printf 'https://t.me/webproxy?server=%s&secret=%s' "$(read_domain)" "$(read_secret)"; }

gen_secret() { openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n'; }

human_dur() {
	local s=$1
	if   ((s >= 86400)); then printf '%dd %dh' $((s / 86400)) $((s % 86400 / 3600))
	elif ((s >= 3600));  then printf '%dh %dm' $((s / 3600))  $((s % 3600 / 60))
	elif ((s >= 60));    then printf '%dm'     $((s / 60))
	else                      printf '%ds'     "$s"
	fi
}

unit_uptime() {
	local ts epoch
	ts="$(systemctl show -p ActiveEnterTimestamp --value "$1" 2>/dev/null)" || return 0
	[[ -n $ts ]] || return 0
	epoch="$(date -d "$ts" +%s 2>/dev/null)" || return 0
	human_dur $(($(date +%s) - epoch))
}

# ── panel ────────────────────────────────────────────────────────────────────

rule() { local p; printf -v p '%*s' "$W" ''; printf '%s' "${p// /─}"; }

# boxrow <left> <left colour> <right> <right colour>. Both texts must be plain
# ASCII so ${#} matches the rendered width and the border stays square.
boxrow() {
	local pad=$((W - 2 - ${#1} - ${#3}))
	((pad < 0)) && pad=0
	printf '  %s│%s %s%s%s%*s%s%s%s %s│%s\n' \
		"$CYN" "$R" "$2" "$1" "$R" "$pad" '' "$4" "$3" "$R" "$CYN" "$R"
}

field() { printf '    %s%-14s%s %s\n' "$D" "$1" "$R" "$2"; }

panel() {
	local domain secret link state colour alive=0 unit code end days conns
	domain="$(read_domain)"; secret="$(read_secret)"; link="$(tg_link)"

	for unit in "${UNITS[@]}"; do
		systemctl is-active --quiet "$unit" 2>/dev/null && alive=$((alive + 1))
	done
	if   ((alive == ${#UNITS[@]})); then state=online;   colour=$GRN
	elif ((alive == 0));            then state=offline;  colour=$RED
	else                                 state=degraded; colour=$YLW
	fi

	printf '\n'
	printf '  %s╭%s╮%s\n' "$CYN" "$(rule)" "$R"
	boxrow WebMTProxy "$B" "" ""
	boxrow "$domain" "" "$state" "$colour"
	printf '  %s╰%s╯%s\n' "$CYN" "$(rule)" "$R"

	head2 SERVICES
	for unit in "${UNITS[@]}"; do
		local s up
		s="$(systemctl is-active "$unit" 2>/dev/null || true)"
		up="$(unit_uptime "$unit")"
		case "$s" in
			active) printf '    %s●%s %-18s %-10s %s%s%s\n' "$GRN" "$R" "$unit" "$s" "$D" "${up:+up $up}" "$R" ;;
			*)      printf '    %s●%s %-18s %-10s\n' "$RED" "$R" "$unit" "${s:-unknown}" ;;
		esac
	done

	head2 HEALTH
	if curl --fail --silent --output /dev/null --max-time 5 http://127.0.0.1:8081/readyz; then
		field relay "${GRN}ready${R}"
	else
		field relay "${RED}not ready${R}"
	fi

	code="$(curl --silent --output /dev/null --max-time 10 --write-out '%{http_code}' "https://$domain/" || echo 000)"
	case "$code" in
		200) field website "${GRN}200${R}" ;;
		000) field website "${RED}unreachable${R}" ;;
		*)   field website "${YLW}${code}${R}" ;;
	esac

	end="$(echo | timeout 5 openssl s_client -connect "127.0.0.1:443" -servername "$domain" 2>/dev/null |
		openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)"
	if [[ -n $end ]]; then
		days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
		if ((days < 10)); then field tls "${YLW}valid, ${days}d left${R}"
		else field tls "${GRN}valid, ${days}d left${R}"; fi
	else
		field tls "${RED}no certificate${R}"
	fi

	if command -v ss >/dev/null; then
		conns="$(ss -Htn state established '( sport = :443 )' 2>/dev/null | wc -l | tr -d ' ')"
		field clients "$conns established on :443"
	fi

	head2 ACCESS
	field secret "$secret"
	field email "$(read_email)"
	field sponsor "$(read_tag || printf '%snone%s' "$D" "$R")"
	printf '\n    %s%s%s\n' "$CYN" "$link" "$R"

	printf '\n  %scommands%s  link · qr · rotate-secret · restart · logs · update · uninstall\n\n' "$D" "$R"
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_link() { tg_link; printf '\n'; }

# The upstream unit has no -P flag. Rather than pin a copy of its ExecStart,
# rebuild the override from whatever the unit currently ships, so it follows
# upstream across updates instead of freezing a stale command line.
cmd_sponsor() {
	local tag=${1:-} exec_line
	if [[ -z "$tag" ]]; then
		printf '%s\n' "$(read_tag || echo none)"
		return 0
	fi
	if [[ "$tag" == off || "$tag" == none ]]; then
		rm -f "$TAG_DROPIN"
		rmdir "$(dirname "$TAG_DROPIN")" 2>/dev/null || true
		systemctl daemon-reload
		systemctl restart mtproxy
		ok "sponsor channel disabled"
		return 0
	fi

	tag="$(printf '%s' "$tag" | tr '[:upper:]' '[:lower:]')"
	[[ "$tag" =~ ^[0-9a-f]{32}$ ]] ||
		die "tag must be 32 hex characters — get it from @MTProxybot"

	exec_line="$(sed -n 's/^ExecStart=//p' "$MTPROXY_UNIT" | head -1)"
	[[ -n "$exec_line" ]] || die "no ExecStart found in $MTPROXY_UNIT"

	install -d -m 0755 "$(dirname "$TAG_DROPIN")"
	cat > "$TAG_DROPIN" <<-EOF
		[Service]
		Environment=MTPROXY_TAG=$tag
		ExecStart=
		ExecStart=$exec_line -P \${MTPROXY_TAG}
	EOF
	chmod 0644 "$TAG_DROPIN"
	systemctl daemon-reload
	systemctl restart mtproxy
	ok "sponsor channel tag set"
}

cmd_qr() {
	command -v qrencode >/dev/null || die "qrencode is not installed: apt-get install -y qrencode"
	printf '\n'
	qrencode -t UTF8 -m 2 "$(tg_link)"
	printf '  %s%s%s\n\n' "$CYN" "$(tg_link)" "$R"
}

# The relay loads the whole site into memory at startup, so publishing means
# replacing the directory and restarting — editing the install-time source
# directory does nothing, which is the trap this command exists to remove.
cmd_site() {
	local src=${1:-} dest backup tags

	if [[ -z "$src" ]]; then
		local upstream dir
		upstream="$(sed -n 's/.*"public_upstream": *"\([^"]*\)".*/\1/p' "$CONFIG")"
		if [[ -n "$upstream" ]]; then
			printf 'upstream %s\n' "$upstream"
		else
			dir="$(sed -n 's/.*"public_dir": *"\([^"]*\)".*/\1/p' "$CONFIG")"
			printf '%s (%s files)\n' "${dir:-unset}" \
				"$(find "${dir:-/nonexistent}" -type f 2>/dev/null | wc -l | tr -d ' ')"
		fi
		return 0
	fi

	[[ -d "$src" ]] || die "no such directory: $src"
	src="$(cd "$src" && pwd -P)"
	# Compare resolved paths: publishing the live directory onto itself would
	# move it aside and then copy from a source that no longer exists.
	dest="$SITE_ROOT"
	[[ -d "$dest" ]] && dest="$(cd "$dest" && pwd -P)"
	[[ "$src" != "$dest" ]] || die "source and destination are the same directory"
	[[ -f "$src/index.html" && -r "$src/index.html" ]] ||
		die "$src must contain a readable index.html — the relay will not start without it"

	# Warnings only. These break the page in the browser, not the relay, and the
	# relay's own response policy is the authority on what survives.
	grep -rlE '<style[ >]' --include='*.html' "$src" >/dev/null 2>&1 &&
		warn "inline <style> found — blocked; move it to an external stylesheet"
	tags="$(grep -rhoE '<script[^>]*>' --include='*.html' "$src" 2>/dev/null | grep -cv 'src=' || true)"
	((tags == 0)) || warn "$tags inline <script> tag(s) — blocked; use same-origin external files"
	grep -rlE '(src|href)="https?://' --include='*.html' "$src" >/dev/null 2>&1 &&
		warn "external resources referenced — only same-origin loads are allowed"
	[[ -z "$(find "$src" -type l -print -quit)" ]] ||
		warn "symlinks found — they are not served"

	if [[ -e "$SITE_ROOT" ]]; then
		backup="$SITE_ROOT.bak.$(date +%Y%m%d%H%M%S)"
		mv "$SITE_ROOT" "$backup"
		ok "previous site kept at $backup"
	fi
	install -d -m 0755 "$SITE_ROOT"
	cp -a "$src/." "$SITE_ROOT/"
	chown -R root:root "$SITE_ROOT"
	chmod -R a+rX "$SITE_ROOT"
	systemctl restart tproxy-server
	ok "$(find "$SITE_ROOT" -type f | wc -l | tr -d ' ') files published to $SITE_ROOT"
}

cmd_restart() {
	local unit
	for unit in mtproxy tproxy-server caddy; do
		systemctl restart "$unit" && ok "restarted $unit"
	done
}

cmd_logs() { exec journalctl -u tproxy-server -u mtproxy -u caddy -f --no-pager; }

cmd_rotate() {
	local new=${1:-} tmp backend
	new="$(printf '%s' "${new:-$(gen_secret)}" | tr '[:upper:]' '[:lower:]')"
	[[ "$new" =~ ^([0-9a-f]{32}|dd[0-9a-f]{32})$ ]] ||
		die "secret must be 32 lowercase hex chars, optionally dd-prefixed"

	# The relay keeps the dd prefix (it is part of the client-facing secret);
	# MTProxy itself only ever sees the bare 32 hex characters.
	backend="$new"; [[ ${#backend} -eq 34 ]] && backend="${backend:2}"

	tmp="$(mktemp "$PROFILES.XXXXXX")"
	sed "s/\"secret\": *\"[^\"]*\"/\"secret\":\"$new\"/" "$PROFILES" > "$tmp"
	grep -q "$new" "$tmp" || { rm -f "$tmp"; die "could not rewrite $PROFILES"; }
	chown root:tproxy "$tmp"; chmod 0400 "$tmp"; mv -f "$tmp" "$PROFILES"

	tmp="$(mktemp "$MTPROXY_ENV.XXXXXX")"
	sed "s/^MTPROXY_SECRET=.*/MTPROXY_SECRET=$backend/" "$MTPROXY_ENV" > "$tmp"
	grep -q "^MTPROXY_SECRET=$backend$" "$tmp" || { rm -f "$tmp"; die "could not rewrite $MTPROXY_ENV"; }
	chown root:mtproxy "$tmp"; chmod 0640 "$tmp"; mv -f "$tmp" "$MTPROXY_ENV"

	systemctl restart mtproxy tproxy-server
	ok "secret rotated — every existing link is now dead"
	printf '\n  %s%s%s\n\n' "$CYN" "$(tg_link)" "$R"
}

cmd_update() {
	[[ -d "$SELF/.git" ]] || die "no git checkout at $SELF — reinstall to enable updates"
	git -C "$SELF" pull --ff-only
	ok "WebMTProxy updated"
	exec "$SELF/install.sh" --domain "$(read_domain)" --email "$(read_email)" \
		--secret "$(read_secret)" --yes
}

cmd_uninstall() {
	local purge=0 reply unit
	[[ "${1:-}" == "--purge" ]] && purge=1

	printf '\n  %sThis removes the proxy, its services and its users.%s\n' "$YLW" "$R"
	((purge == 1)) && printf '  %s--purge also deletes /srv/tproxy-site and the TLS certificates.%s\n' "$YLW" "$R"
	printf '  %s?%s Type the hostname to confirm: ' "$CYN" "$R"
	read -r reply </dev/tty || true
	[[ "$reply" == "$(read_domain)" ]] || die "aborted"
	printf '\n'

	for unit in tproxy-server mtproxy caddy tproxy-firewall refresh-mtproxy-config.timer; do
		systemctl disable --now "$unit" >/dev/null 2>&1 || true
	done
	rm -f /etc/systemd/system/{tproxy-server,mtproxy,tproxy-firewall,refresh-mtproxy-config}.service \
		/etc/systemd/system/refresh-mtproxy-config.timer \
		/etc/systemd/system/caddy.service \
		/etc/systemd/system/caddy.service.d/tproxy.conf
	rmdir /etc/systemd/system/caddy.service.d 2>/dev/null || true
	systemctl daemon-reload
	ok "services removed"

	rm -f /usr/local/bin/tproxy-server /usr/local/bin/caddy /usr/local/sbin/refresh-mtproxy-config
	rm -rf /etc/tproxy-server /etc/mtproxy /etc/caddy /opt/MTProxy /opt/tproxy-server
	ok "binaries and configuration removed"

	if ((purge == 1)); then
		# Kept by default: re-issuing certificates burns Let's Encrypt rate limits.
		rm -rf /srv/tproxy-site /var/lib/caddy
		ok "website and certificates removed"
	else
		printf '    %skept /srv/tproxy-site and /var/lib/caddy (--purge removes them)%s\n' "$D" "$R"
	fi

	for unit in tproxy mtproxy caddy; do userdel "$unit" >/dev/null 2>&1 || true; done
	rm -f /usr/local/bin/webmtproxy
	rm -rf "$SELF"
	ok "uninstalled"
	printf '\n'
}

usage() {
	cat <<-EOF

	  ${B}webmtproxy${R} — control panel for the Telegram WEB proxy

	    webmtproxy                 the panel: services, health, TLS, link
	    webmtproxy link            print the t.me/webproxy link
	    webmtproxy qr              print it as a QR code
	    webmtproxy rotate-secret   new secret, restart, print the new link
	    webmtproxy sponsor [TAG]   show, set or (with "off") clear the ad tag
	    webmtproxy site [DIR]      show the cover site, or publish DIR as it
	    webmtproxy restart         restart mtproxy, relay and Caddy
	    webmtproxy logs            follow all three journals
	    webmtproxy update          pull WebMTProxy, rebuild from upstream
	    webmtproxy uninstall       remove everything (--purge: site and certs too)

	EOF
}

# Sourced by test_install.sh, which wants the helpers without running a command.
[[ "${WEBMTPROXY_LIB:-}" == 1 ]] && return 0

case "${1:-panel}" in
	panel|status)   require_root; require_install; panel ;;
	link)           require_root link; require_install; cmd_link ;;
	qr)             require_root qr; require_install; cmd_qr ;;
	rotate-secret)  require_root rotate-secret; require_install; cmd_rotate "${2:-}" ;;
	sponsor)        require_root sponsor; require_install; cmd_sponsor "${2:-}" ;;
	site)           require_root site; require_install; cmd_site "${2:-}" ;;
	restart)        require_root restart; require_install; cmd_restart ;;
	logs)           require_root logs; cmd_logs ;;
	update)         require_root update; require_install; cmd_update ;;
	uninstall)      require_root uninstall; require_install; cmd_uninstall "${2:-}" ;;
	-h|--help|help) usage ;;
	*)              usage; die "unknown command: $1" ;;
esac
